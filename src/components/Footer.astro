---
import LogoPlaceholder from './atoms/LogoPlaceholder.astro';
import { CONTACT, FOOTER_DESCRIPTION, NAV_LINKS, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="bg-footer-bg text-footer-text">
	<div class="container-page grid gap-12 py-section sm:grid-cols-2 lg:grid-cols-3">
		<div>
			<LogoPlaceholder inverted />
			<p class="mt-6 max-w-xs font-body text-base text-footer-text/80">
				{FOOTER_DESCRIPTION}
			</p>
		</div>

		<div>
			<h3 class="font-display text-sm font-semibold tracking-[0.15em] text-footer-text uppercase">
				Enlaces rápidos
			</h3>
			<ul class="mt-6 space-y-3">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								class="font-body text-footer-text/80 transition-colors duration-base hover:text-white"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<h3 class="font-display text-sm font-semibold tracking-[0.15em] text-footer-text uppercase">
				Contacto
			</h3>
			<ul class="mt-6 space-y-3 font-body text-footer-text/80">
				<li>
					<a
						href={CONTACT.phoneHref}
						class="transition-colors duration-base hover:text-white"
					>
						{CONTACT.phone}
					</a>
				</li>
				<li>
					<a
						href={CONTACT.emailHref}
						class="transition-colors duration-base hover:text-white"
					>
						{CONTACT.email}
					</a>
				</li>
				<li>{CONTACT.location}</li>
			</ul>
		</div>
	</div>

	<div class="border-t border-text-primary/40">
		<div class="container-page py-6 text-center text-sm text-footer-text/60">
			© {year} {SITE_TITLE}. Todos los derechos reservados.
		</div>
	</div>
</footer>