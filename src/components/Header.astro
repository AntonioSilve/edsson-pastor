---
import LogoPlaceholder from './atoms/LogoPlaceholder.astro';
import HamburgerButton from './atoms/HamburgerButton.astro';
import { NAV_LINKS } from '../consts';
---

<header id="site-header" class="sticky top-0 z-50 bg-base-white/90 backdrop-blur transition-all duration-base">
	<div class="header-inner mx-auto flex max-w-6xl items-center justify-between px-6 py-4 transition-all duration-base lg:px-8 lg:py-5">
		<LogoPlaceholder />

		<nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						class="font-display text-sm font-medium text-text-secondary transition-colors duration-base hover:text-accent"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<HamburgerButton />
	</div>
</header>

<div id="mobile-menu" aria-hidden="true" class="mobile-menu fixed inset-0 z-40 flex flex-col items-center justify-center gap-2 bg-base-white">
	<nav class="flex flex-col items-center gap-6" aria-label="Navegación móvil">
		{
			NAV_LINKS.map((link) => (
				<a
					href={link.href}
					class="mobile-link font-display text-2xl font-medium text-text-secondary transition-colors duration-base hover:text-accent"
				>
					{link.label}
				</a>
			))
		}
	</nav>
</div>

<style>
	.mobile-menu {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 300ms ease,
			visibility 300ms ease;
	}
	.mobile-menu.open {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}
	.mobile-link {
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 300ms ease 100ms,
			transform 300ms ease 100ms;
	}
	.mobile-menu.open .mobile-link {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	const header = document.getElementById('site-header') as HTMLElement;
	const menu = document.getElementById('mobile-menu') as HTMLElement;
	const inner = header.querySelector('.header-inner') as HTMLElement;

	const closeMenu = () => {
		menu.classList.remove('open');
		menu.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	};

	const onScroll = () => {
		if (window.scrollY > 50) {
			header.classList.add('shadow-header');
			inner.classList.add('py-2');
			inner.classList.remove('py-4', 'lg:py-5');
		} else {
			header.classList.remove('shadow-header');
			inner.classList.remove('py-2');
			inner.classList.add('py-4', 'lg:py-5');
		}
	};

	document.addEventListener('toggle-menu', (event: Event) => {
		const { open } = (event as CustomEvent<{ open: boolean }>).detail;
		if (open) {
			menu.classList.add('open');
			menu.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		} else {
			closeMenu();
		}
	});

	menu.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	document.addEventListener('keydown', (event: KeyboardEvent) => {
		if (event.key === 'Escape') closeMenu();
	});

	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>