---
const servicios = [
	{
		icon: 'square',
		title: 'Diseño Residencial',
		description:
			'Creación de espacios habitables que reflejan tu estilo de vida y personalidad.',
	},
	{
		icon: 'circle',
		title: 'Diseño Comercial',
		description:
			'Soluciones arquitectónicas funcionales y estéticas para negocios y espacios corporativos.',
	},
	{
		icon: 'triangle',
		title: 'Medición de Terrenos',
		description:
			'Levantamientos topográficos precisos para garantizar la viabilidad de tu proyecto.',
	},
];
---

<section id="servicios" class="scroll-mt-24 py-section">
	<div class="container-page">
		<h2 class="font-display text-h2 font-semibold tracking-tight text-text-primary">
			Servicios
		</h2>

		<div class="mt-element grid gap-component md:grid-cols-2 lg:grid-cols-3">
			{
				servicios.map(({ icon, title, description }) => (
					<div
						class="group rounded-lg bg-base-warm p-element shadow-none transition-all duration-base hover:-translate-y-1 hover:shadow-md"
					>
						<div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg bg-accent-light">
						{icon === 'square' && (
							<div class="h-5 w-5 rotate-45 bg-accent/70"></div>
						)}
						{icon === 'circle' && (
							<div class="h-5 w-5 rounded-full bg-accent/70"></div>
						)}
						{icon === 'triangle' && (
							<div class="triangle-shape"></div>
						)}
						</div>
						<h3 class="font-display text-h3 font-medium text-text-primary">
							{title}
						</h3>
						<p class="mt-3 font-body text-text-secondary">
							{description}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.triangle-shape {
		width: 0;
		height: 0;
		border-left: 10px solid transparent;
		border-right: 10px solid transparent;
		border-bottom: 18px solid rgb(125 107 95 / 0.7);
	}
</style>