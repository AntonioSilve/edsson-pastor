---
interface Props {
	variant?: 'primary' | 'secondary';
	href?: string;
	type?: 'submit' | 'button' | 'reset';
	class?: string;
}

const { variant = 'primary', href, type = 'button', class: className = '' } = Astro.props;

const baseClass =
	'inline-flex items-center justify-center gap-2 rounded-md px-6 py-3 font-display text-sm font-medium transition-colors duration-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';

const variantClass =
	variant === 'primary'
		? 'bg-accent text-white hover:bg-accent-hover'
		: 'border border-accent bg-transparent text-accent hover:bg-accent-light';
---

{
	href ? (
		<a href={href} class={`${baseClass} ${variantClass} ${className}`}>
			<slot />
		</a>
	) : (
		<button type={type} class={`${baseClass} ${variantClass} ${className}`}>
			<slot />
		</button>
	)
}